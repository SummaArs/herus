{
  "schema": "herus-haptic-bench-evidence-v1",
  "extends": "herus-bench-evidence-v1",
  "record_rules": {
    "one_record_per_gate_run": true,
    "product_content_forbidden": [
      "audio",
      "transcript",
      "embedding",
      "identity",
      "location",
      "key",
      "pair_key",
      "message_content",
      "raw_model_prompt",
      "raw_model_response",
      "free_text",
      "participant_id"
    ],
    "required_digest": "sha256(canonical_json_without_record_digest)",
    "time_basis": "monotonic_instrument_or_declared_host_clock",
    "missing_value": "null_not_zero",
    "no_claim_from_missing": true,
    "fixture_before_wrist": true,
    "authority_boundary": "haptic_playback_never_authorizes_send_persist_execute"
  },
  "required_fields": {
    "gate_id": "string",
    "execution_origin": "string",
    "protocol_revision": "string",
    "board_revision": "string",
    "adapter_revision": "string",
    "mcu_part_marking": "string",
    "haptic_driver_part_marking": "string",
    "actuator_type": "string",
    "actuator_revision": "string",
    "haptic_profile_version": "string",
    "firmware_commit": "sha1_or_sha256_string",
    "prove_verdict": "ALL INVARIANTS HOLD",
    "instrument_id": "string",
    "instrument_calibration_due": "date_or_null",
    "sampling_method": "string",
    "start_timestamp_ms": "integer_or_null",
    "duration_ms": "integer_or_null",
    "i2c_clock_hz": "integer_or_null",
    "i2c_transactions": "integer_or_null",
    "i2c_error_count": "integer_or_null",
    "drive_frequency_hz": "number_or_null",
    "accel_rms_mps2": "number_or_null",
    "pulse_duration_us": "number_or_null",
    "inter_slot_pause_us": "number_or_null",
    "supply_voltage_mv": "number_or_null",
    "supply_current_ma": "number_or_null",
    "temperature_c": "number_or_null",
    "energy_uj": "number_or_null",
    "latency_us": "number_or_null",
    "safety_stop": "boolean_or_null",
    "fixture_only": "boolean",
    "raw_log_digest": "sha256_string_or_null",
    "result": "pass_fail_blocked",
    "failure_reason_code": "string_or_null",
    "record_digest": "sha256_string"
  },
  "allowed_values": {
    "execution_origin": ["physical_operator", "host_stub", "blocked_no_hardware"],
    "actuator_type": ["ERM", "LRA", "UNVERIFIED"],
    "result": ["pass", "fail", "blocked_by_missing_evidence"]
  },
  "required_relations": [
    "fixture_only must be true for the first bring-up gate",
    "safety_stop must be true or null when no safety-stop test was run",
    "i2c_error_count must be zero for a pass result",
    "raw_log_digest must be present for pass or fail",
    "failure_reason_code must be present for fail or blocked_by_missing_evidence",
    "failure_reason_code must be absent for pass",
    "pass requires execution_origin physical_operator",
    "blocked_no_hardware requires result blocked_by_missing_evidence",
    "host_stub cannot produce a physical pass",
    "actuator_type and haptic_profile_version must match the declared profile",
    "no field may contain a semantic event payload, text, audio, identity or location"
  ],
  "allowed_failure_reason_examples": [
    "BOARD_REVISION_MISMATCH",
    "PIN_MAP_UNVERIFIED",
    "I2C_BUS_UNVERIFIED",
    "DRV2605L_NOT_FOUND",
    "ACTUATOR_PROFILE_MISMATCH",
    "PROFILE_CALIBRATION_MISSING",
    "INSTRUMENT_CALIBRATION_MISSING",
    "I2C_TRANSACTION_FAILED",
    "SAFETY_STOP_UNAVAILABLE",
    "FIXTURE_NOT_ISOLATED",
    "RAW_LOG_CONTAINS_FORBIDDEN_FIELD",
    "PROVE_BASELINE_FAILED",
    "HARDWARE_NOT_ATTACHED",
    "GATE_CRITERION_FAILED"
  ]
}
