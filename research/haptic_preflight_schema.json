  "failure_reason_examples": [
    "HARDWARE_NOT_ATTACHED",
    "BOARD_IDENTITY_UNVERIFIED",
    "RADIO_VARIANT_UNVERIFIED",
    "SCHEMATIC_UNVERIFIED",
    "PIN_MAP_UNVERIFIED",
    "CONTINUITY_NOT_MEASURED",
    "SHORT_CHECK_FAILED",
    "PULLUPS_UNVERIFIED",
